# Copie este arquivo para ".env" e preencha. NUNCA faça commit do ".env".

NODE_ENV=production
PORT=3000

# URL da implantação do Google Apps Script (app da Web) - termina em /exec
APPS_SCRIPT_URL=
# Segredo compartilhado: o MESMO valor da propriedade SECRET no Apps Script
APPS_SCRIPT_SECRET=

# Token de acesso ao painel /admin (mínimo 16 caracteres aleatórios)
ADMIN_TOKEN=

# Opcional: nº de proxies confiáveis à frente do servidor (padrão: 1 em produção, 0 local)
# TRUST_PROXY=1
# Opcional: tempo máximo de espera pelo Apps Script, em ms (padrão: 25000)
# APPS_SCRIPT_TIMEOUT_MS=25000
